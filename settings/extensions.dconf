# Extension settings of the macstyle desktop, loaded by install.sh with `dconf load /`.
# Dark Style switches some of them at run time (bin/macstyle-darkswitch).

[org/gnome/shell/extensions/appmenu]
icon-size=20
lock-to-focused-app=true
menu-icon='distributor-logo-fedora'
[org/gnome/shell/extensions/blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_97636408372440'>, 'params': <{'brightness_multiplicator': <1.1899999999999999>}>}>, <{'type': <'native_static_gaussian_blur'>, 'id': <'effect_76035806030990'>, 'params': <{'brightness': <0.69999999999999996>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}}
settings-version=2

[org/gnome/shell/extensions/blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=1.0
override-background=true
pipeline='pipeline_default_rounded'
sigma=2
static-blur=false
style-dash-to-dock=1
unblur-in-overview=false

[org/gnome/shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/overview]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
pipeline='pipeline_default'
sigma=30

[org/gnome/shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30
[org/gnome/shell/extensions/caffeine]
show-indicator='only-active'
[org/gnome/shell/extensions/coverflowalttab]
switcher-background-color=(0.20784313725490197, 0.51764705882352946, 0.89411764705882357)
[org/gnome/shell/extensions/dash2dock-motion]
animation-time=0.20000000000000001
apply-custom-theme=true
autohide=true
autohide-in-fullscreen=false
background-color='rgb(255,255,255)'
background-opacity=0.089999999999999997
click-action='cycle-windows'
custom-background-color=true
custom-theme-shrink=true
customize-alphas=true
dash-max-icon-size=47
dock-fixed=false
dock-position='BOTTOM'
edge-distance=0
glass-outline=true
height-fraction=0.90000000000000002
hide-delay=0.20000000000000001
icon-size-fixed=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
isolate-monitors=false
isolate-workspaces=false
magnify-effect-width=260
magnify-max-scale=1.3
magnify-rise=0.0
max-alpha=0.25
min-alpha=0.0
multi-monitor=true
preferred-monitor=-2
pressure-threshold=100.0
preview-size-scale=0.070000000000000007
require-pressure-to-show=true
running-indicator-style='DEFAULT'
show-apps-at-top=true
show-delay=0.25
show-dock-urgent-notify=true
show-icon-highlight=false
show-mounts=true
show-mounts-network=false
transparency-mode='FIXED'
[org/gnome/shell/extensions/ding]
check-x11wayland=true
[org/gnome/shell/extensions/just-perfection]
accent-color-icon=false
background-menu=true
controls-manager-spacing-size=0
dash=true
double-super-to-appgrid=true
invert-calendar-column-items=false
osd=true
panel=true
panel-in-overview=true
ripple-box=true
search=true
startup-status=1
support-notifier-type=0
theme=false
window-demands-attention-focus=false
window-picker-icon=true
window-preview-caption=true
window-preview-close-button=true
workspace=true
workspace-background-corner-size=0
workspace-popup=true
workspaces-in-app-grid=true
[org/gnome/shell/extensions/multi-monitors-bar]
available-indicators=['appmenu@ChathurangaBW.github.io-0', 'appmenu@ChathurangaBW.github.io-1', 'appmenu@ChathurangaBW.github.io-2', 'appmenu@ChathurangaBW.github.io-3', 'appmenu@ChathurangaBW.github.io-4', 'appmenu@ChathurangaBW.github.io-5', 'appmenu@ChathurangaBW.github.io-6', 'appmenu@ChathurangaBW.github.io-7', 'appmenu@ChathurangaBW.github.io-user-switcher', 'clipboardIndicator', 'uniteWindowControls', 'apps-menu']
date-time-position='right-after-tray'
show-app-menu=true
[org/gnome/shell/extensions/rounded-window-corners-reborn]
border-width=-1
focused-shadow={'horizontalOffset': 0, 'verticalOffset': 8, 'blurOffset': 18, 'spreadRadius': -4, 'opacity': 68}
global-rounded-corner-settings={'padding': <{'left': uint32 1, 'right': 1, 'top': 1, 'bottom': 1}>, 'keepRoundedCorners': <{'maximized': false, 'fullscreen': false}>, 'borderRadius': <uint32 12>, 'smoothing': <0.0>, 'borderColor': <(0.0, 0.0, 0.0, 0.12)>, 'enabled': <true>}
settings-version=uint32 9
skip-libadwaita-app=true
unfocused-shadow={'horizontalOffset': 0, 'verticalOffset': 6, 'blurOffset': 16, 'spreadRadius': -5, 'opacity': 50}
[org/gnome/shell/extensions/status-area-horizontal-spacing]
hpadding=2
[org/gnome/shell/extensions/top-bar-organizer-plus]
appindicator-order-mode='safe'
center-box-order=@as []
family-order-gsconnect=@as []
item-creators={'activities': '', 'appmenu@ChathurangaBW.github.io-0': '', 'appmenu@ChathurangaBW.github.io-1': '', 'appmenu@ChathurangaBW.github.io-2': '', 'appmenu@ChathurangaBW.github.io-3': '', 'appmenu@ChathurangaBW.github.io-4': '', 'appmenu@ChathurangaBW.github.io-5': '', 'appmenu@ChathurangaBW.github.io-6': '', 'appmenu@ChathurangaBW.github.io-7': '', 'apps-menu': '', 'dateMenu': '', 'quickSettings': '', 'keyboard': '', 'a11y': '', 'dwellClick': '', 'screenSharing': '', 'appmenu@ChathurangaBW.github.io-user-switcher': '', 'screenRecording': '', 'clipboardIndicator': 'clipboard-indicator@tudmotu.com', 'Space Bar': 'space-bar@luchrioh', 'uniteWindowControls': 'unite@hardpixel.eu', 'appmenu@ChathurangaBW.github.io-8': 'appmenu@ChathurangaBW.github.io', 'appmenu@ChathurangaBW.github.io-9': 'appmenu@ChathurangaBW.github.io', 'appmenu@ChathurangaBW.github.io-10': 'appmenu@ChathurangaBW.github.io', 'appmenu@ChathurangaBW.github.io-11': 'appmenu@ChathurangaBW.github.io', 'appmenu@ChathurangaBW.github.io-12': 'appmenu@ChathurangaBW.github.io'}
left-box-order=['appmenu@ChathurangaBW.github.io-0', 'uniteWindowControls', 'appmenu@ChathurangaBW.github.io-1', 'appmenu@ChathurangaBW.github.io-2', 'appmenu@ChathurangaBW.github.io-3', 'appmenu@ChathurangaBW.github.io-4', 'appmenu@ChathurangaBW.github.io-5', 'appmenu@ChathurangaBW.github.io-6', 'appmenu@ChathurangaBW.github.io-7', 'appmenu@ChathurangaBW.github.io-8', 'appmenu@ChathurangaBW.github.io-9', 'appmenu@ChathurangaBW.github.io-10', 'appmenu@ChathurangaBW.github.io-11', 'appmenu@ChathurangaBW.github.io-12', 'appmenu@ChathurangaBW.github.io-13', 'appmenu@ChathurangaBW.github.io-14', 'appmenu@ChathurangaBW.github.io-15', 'appmenu@ChathurangaBW.github.io-16', 'appmenu@ChathurangaBW.github.io-17', 'appmenu@ChathurangaBW.github.io-18', 'appmenu@ChathurangaBW.github.io-19', 'apps-menu', 'Space Bar']
