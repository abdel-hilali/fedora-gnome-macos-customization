// macstyle: what a new terminal window shows (fastfetch).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Fedora_small",
    "color": {
      "1": "blue",
      "2": "default"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "blue"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "  OS",
      "format": "{2} {9}"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "  Uptime"
    },
    {
      "type": "packages",
      "key": "  Packages"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "de",
      "key": "  Desktop"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": "󰍛  Memory"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
